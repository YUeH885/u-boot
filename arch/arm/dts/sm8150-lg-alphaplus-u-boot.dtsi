// SPDX-License-Identifier: BSD-3-Clause
/*
 * U-Boot additions for LG LM-G820N (Qualcomm SM8150)
 *
 * Copyright (c) 2026 AlphaPlus Porting Project
 */

/ {
	chosen {
		/delete-property/ stdout-path;
	};
};

&sdhc_2 {
	clocks = <&gcc GCC_SDCC2_AHB_CLK>,
		 <&gcc GCC_SDCC2_APPS_CLK>;
	clock-names = "iface", "core";
};

/* The SM8150 USB3/DP combo PHY has no U-Boot driver. */
&usb_1 {
	qcom,select-utmi-as-pipe-clk;
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
};

&usb_1_qmpphy {
	status = "disabled";
};

&vreg_l2a_3p1 {
	regulator-always-on;
	regulator-boot-on;
};

&vreg_l5a_0p875 {
	regulator-always-on;
	regulator-boot-on;
};

&vreg_l12a_1p8 {
	regulator-always-on;
	regulator-boot-on;
};
