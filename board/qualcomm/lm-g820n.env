bootdelay=0
bootretry=3
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=echo LM-G820N U-Boot ready

# Storage is probed only when selected so failures leave the menu accessible.
fastboot=scsi scan; fastboot -l ${fastboot_addr_r} usb 0
serial_gadget=echo Open the USB ACM port on the host to continue; \
	setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1

prepare_linux_ufs=scsi scan && part number scsi 0 linux part_num
boot_linux_ufs=run prepare_linux_ufs && \
	sysboot scsi 0:${part_num} any ${scriptaddr} /boot/extlinux/extlinux.conf

bootcmd=setenv bootcmd run menucmd; bootmenu 3
bootmenu_autoboot=run boot_linux_ufs || pause
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot Linux from UFS (linux partition)=run prepare_linux_ufs && \
	sysboot -p scsi 0:${part_num} any ${scriptaddr} /boot/extlinux/extlinux.conf || pause
bootmenu_1=Boot Linux from MicroSD=mmc dev 0 && mmc rescan && \
	sysboot -p mmc 0:1 any ${scriptaddr} /boot/extlinux/extlinux.conf || pause
bootmenu_2=UEFI boot manager=scsi scan; bootefi bootmgr ${fdt_addr_r}; pause
bootmenu_3=USB fastboot=run fastboot
bootmenu_4=USB serial console (CDC ACM)=run serial_gadget
bootmenu_5=USB mass storage (UFS LUN0)=scsi scan; ums 0 scsi 0
bootmenu_6=USB mass storage (MicroSD)=mmc dev 0; mmc rescan; ums 0 mmc 0
bootmenu_7=U-Boot shell=setenv bootretry -1
bootmenu_8=System information=bdinfo; pause
bootmenu_9=Environment=printenv; pause
bootmenu_10=Reboot=reset
bootmenu_11=Power off=poweroff
button_cmd_0_name=Volume Down
button_cmd_0=setenv bootcmd run menucmd
